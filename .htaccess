# ==============================================================================
# InfinityFree Apache Configuration (.htaccess)
# ==============================================================================

# 1. Set default landing page
DirectoryIndex index.php index.html

# 2. Set default character encoding
AddDefaultCharset UTF-8

# 3. Enable URL Rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

# 4. Block direct web access to sensitive project files
<FilesMatch "\.(sql|md|yaml|dockerignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<FilesMatch "^(Dockerfile|\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# 5. Prevent direct HTTP requests into config folder
<IfModule mod_rewrite.c>
    RewriteRule ^config/.*$ - [F,L]
</IfModule>

# 6. Correct MIME types for SVG and web assets
<IfModule mod_mime.c>
    AddType image/svg+xml .svg .svgz
</IfModule>
