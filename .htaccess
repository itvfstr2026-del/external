# ==============================================================================
# Vignan's Question Paper Feedback Portal - Apache Configuration (.htaccess)
# ==============================================================================

# 1. Set default landing page
DirectoryIndex index.php

# 2. Disable directory listing (prevents users from seeing folder files)
Options -Indexes

# 3. Default Charset
AddDefaultCharset UTF-8

# 4. Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

# 5. Protect sensitive files from direct web access
<FilesMatch "^(schema\.sql|render\.yaml|Dockerfile|\.gitignore|\.dockerignore|\.git.*|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 6. Protect sensitive folders (config, templates) from direct file browsing
<IfModule mod_rewrite.c>
    RewriteRule ^config(/.*)?$ - [F,L]
</IfModule>

# 7. MIME Types for Assets
<IfModule mod_mime.c>
    AddType image/svg+xml .svg .svgz
    AddType application/font-woff2 .woff2
    AddType application/font-woff .woff
</IfModule>
